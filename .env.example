# ===== 应用 =====
ENV=dev
SECRET_KEY=please-change-this-to-a-random-32-bytes-string
AES_KEY=please-change-this-32-bytes-base64-key!!

# ===== 数据库 =====
POSTGRES_USER=jingguan
POSTGRES_PASSWORD=jingguan
POSTGRES_DB=jingguan
POSTGRES_PORT=5432
# 应用读写连接
DATABASE_URL=postgresql+asyncpg://jingguan:jingguan@localhost:5432/jingguan
# Agent 取数专用只读连接（必须，安全兜底）
BI_READONLY_URL=postgresql+asyncpg://bi_readonly:bi_readonly@localhost:5432/jingguan

# ===== 缓存 / 队列 =====
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ===== 对象存储 =====
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123456
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=jingguan

# ===== 模型 =====
LLM_DEFAULT_PROVIDER=deepseek
LLM_DEFAULT_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_FALLBACK_MODELS=qwen2.5-72b-instruct,ollama/qwen2.5:7b
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=

# ===== 问数安全 =====
SQL_MAX_ROWS=5000
SQL_TIMEOUT_MS=15000
RATE_LIMIT_QA=10/minute

# ===== 端口 =====
API_PORT=8000
WEB_PORT=5180
